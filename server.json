{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SwaDeshiTech/prodhub",
  "title": "ProdHub Application Delivery",
  "description": "Deploy and diagnose applications in governed Kubernetes Preview Spaces through authenticated MCP.",
  "repository": {
    "url": "https://github.com/SwaDeshiTech/prodhub-agent-kit",
    "source": "github"
  },
  "version": "0.5.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://app.prodhub.in/mcp"
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "homepage": "https://prodhub.in/mcp",
      "setup": "https://prodhub.in/setup",
      "documentation": "https://prodhub.in/docs/mcp",
      "authentication": "OAuth 2.1 authorization code with PKCE",
      "capabilities": [
        "application onboarding",
        "build and deployment profiles",
        "Kubernetes Preview Spaces",
        "pipeline monitoring and diagnosis",
        "read-only container inspection"
      ]
    }
  }
}
